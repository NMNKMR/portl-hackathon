# Expo public env (safe to ship in the client).
# Never put service_role / sb_secret_* keys here — those are backend-only.
EXPO_PUBLIC_SUPABASE_URL=

# Client API key (low privilege, RLS-enforced). Either works:
#   - Legacy: anon JWT (eyJ...)
#   - Preferred going forward: publishable key (sb_publishable_...)
# Put whichever you use in this same variable — supabase-js createClient 2nd arg.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
